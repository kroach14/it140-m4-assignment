START hilow_game

lower_bound = input ("Please enter a low number")
high_bound = input ("Please enter a high number")

while lower_bound >= high_bound:
    print ("Please make sure your first number is less than the second")
    lower_bound = input ("Please enter a low number")
    high_bound = input ("Please enter a high number")

target_num = generate a random number between lower_bound and high_bound
guess = input ("Guess a number within the range")

while guess != target_num
    if guess < lower_bound OR guess > higher_bound:
        print ("please enter a number within range")
    elif guess < target_num
        print ("Nope, too low!")
    else:
        print ("Nope, too high!")

print ("Great, you got it!")

END hilow_game
